# Copiar este archivo a .streamlit/secrets.toml y completar con los valores reales
# para desarrollo local. Para Streamlit Community Cloud, pegar este mismo
# contenido (con los valores reales) en "App settings -> Secrets" — ahí no se
# usa un archivo.

# "parquet" -> lee Data/forecast_final_semanal.parquet (desarrollo local, sin Lakehouse)
# "onelake" -> lee la tabla Delta directo de OneLake (Microsoft Fabric)
DATA_SOURCE = "parquet"

# --- OneLake (Microsoft Fabric) ---
# ONELAKE_WORKSPACE: nombre (o GUID) del workspace de Fabric.
# ONELAKE_LAKEHOUSE: nombre del Lakehouse dentro de ese workspace.
# Se ven en la URL de Fabric al abrir el Lakehouse:
#   https://app.fabric.microsoft.com/groups/<workspace>/lakehouses/<lakehouse-id>
ONELAKE_WORKSPACE = "NombreDelWorkspace"
ONELAKE_LAKEHOUSE = "NombreDelLakehouse"
ONELAKE_TABLA_FORECAST = "forecast_final_semanal"

# --- Service Principal (Microsoft Entra ID) con permisos de lectura sobre el Lakehouse ---
# Se crea en Azure AD (App registration) y se le otorga acceso al workspace de Fabric
# como "Viewer" (o superior).
AZURE_TENANT_ID = "00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID = "00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET = "reemplazar_con_el_client_secret"
